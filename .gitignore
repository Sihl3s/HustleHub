# Dependencies
node_modules/

# Environment secrets — never commit real values (OWASP, 2025)
.env
.env.local

# Local TLS material generated by npm run generate-certs
backend/certs/*.pem
backend/certs/*.key
backend/certs/*.crt
!backend/certs/.gitkeep

# File-based user store (Part 1). Data files must not be committed.
backend/data/*.json
!backend/data/.gitkeep

# Logs and OS files
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# Editor
.idea/
.vscode/
.vs/
*.swp
