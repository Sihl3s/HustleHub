      "name": "3. Bookings and transactions",
      "item": [
        {
          "name": "Client books a gig (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const booking = pm.response.json().booking;",
                  "pm.test('Booking is confirmed with a reference', () => {",
                  "  pm.expect(booking.status).to.eql('confirmed');",
                  "  pm.expect(booking.confirmationReference).to.match(/^HH-/);",
                  "});",
                  "pm.test('Price comes from the gig, not the client', () => pm.expect(booking.price).to.eql(1800));",
                  "pm.test('A transaction was recorded for the booking', () => pm.expect(booking.transaction.amount).to.eql(1800));",
                  "pm.collectionVariables.set('bookingId', booking.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
