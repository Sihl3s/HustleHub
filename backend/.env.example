# Copy this file to .env and replace the placeholder secret before starting the API.
# Never commit .env — secrets belong in the environment, not in source control.

# HTTPS listen port (3443 avoids needing administrator rights for 443)
PORT=3443

# Must be at least 32 characters. Generate a random value for local development.
JWT_SECRET=replace-with-at-least-32-character-secret-key

# Access token lifetime (jsonwebtoken duration string)
JWT_EXPIRES_IN=1h

# Issuer and audience claims every token must carry
JWT_ISSUER=hustlehub-api
JWT_AUDIENCE=hustlehub-web

# development | production (production also enables HSTS)
NODE_ENV=development

# MongoDB connection string (local default shown; use an Atlas URI if hosted)
MONGODB_URI=mongodb://127.0.0.1:27017/hustlehub

# Optional rate limits (requests per window). Uncomment to override the defaults shown.
# Login + register, per IP, per 15 minutes
# AUTH_RATE_LIMIT_MAX=20
# Booking creation, per client account, per hour
# BOOKING_RATE_LIMIT_MAX=10
# Gig create/update/delete, per freelancer, per 15 minutes
# WRITE_RATE_LIMIT_MAX=60
# All /api requests, per IP, per 15 minutes
# API_RATE_LIMIT_MAX=300
