# Copy this file to .env and replace the placeholder secret before starting the API.
# Never commit .env — secrets belong in the environment, not in source control.

# HTTPS listen port (3443 avoids needing administrator rights for 443)
PORT=3443

# Must be at least 32 characters. Generate a random value for local development.
JWT_SECRET=replace-with-at-least-32-character-secret-key

# Access token lifetime (jsonwebtoken duration string)
JWT_EXPIRES_IN=1h

# development | production
NODE_ENV=development
